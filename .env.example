# Application
APP_NAME=nalssi
LOG_LEVEL=INFO
DEBUG=false

# Database
# SQLite (default for local development):
DATABASE_URL=sqlite:///./nalssi.db
# PostgreSQL (used by docker-compose):
# DATABASE_URL=postgresql://nalssi:nalssi@localhost:5432/nalssi

# Security
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY_ENCRYPTION_KEY=your-encryption-key-change-in-production

# Weather APIs
NOAA_API_BASE_URL=https://api.weather.gov
OPEN_METEO_API_BASE_URL=https://api.open-meteo.com/v1
WEATHERAPI_API_KEY=

# Collection
DEFAULT_COLLECTION_INTERVAL=300   # seconds (5 minutes) - current weather + alerts
FORECAST_COLLECTION_INTERVAL=3600  # seconds (1 hour) - forecasts
MAX_CONCURRENT_COLLECTIONS=5

# Alert priorities (optional)
# Path to a YAML file overriding alert display priorities. Same schema as the
# bundled app/services/outputs/formats/alert_priorities.yaml; merged on top of
# it (only the keywords/severities you list change). Read once at startup.
# ALERT_PRIORITIES_FILE=./alert_priorities.override.yaml

# Radar imagery (NWS/NCEP GeoServer WMS, no API key required)
# Frames are stored on disk under RADAR_STORAGE_DIR and pruned to a rolling
# window. The upstream service only offers ~2 hours of history, so retention
# above 120 minutes has no additional effect.
# Set false to remove radar entirely: no routes, no nav item, no collection.
RADAR_ENABLED=true
RADAR_STORAGE_DIR=./data/radar
RADAR_COLLECTION_INTERVAL=300
RADAR_RETENTION_MINUTES=120
# Width/height of each location's view, in km, and the image size in pixels
RADAR_VIEW_SPAN_KM=240
RADAR_IMAGE_SIZE=600
RADAR_MAX_CONCURRENT_FETCHES=4
# Distance rings drawn around each location, in km. Empty disables them.
RADAR_RANGE_RINGS_KM=50,100
# RADAR_WMS_BASE_URL=https://opengeo.ncep.noaa.gov/geoserver/ows
# Canadian radar (MSC GeoMet), used automatically for country_code=CA locations
# RADAR_GEOMET_URL=https://geo.weather.gc.ca/geomet
# Water shading for the basemap. Empty disables the water band.
# RADAR_HYDRO_WMS_URL=https://basemap.nationalmap.gov/arcgis/services/USGSHydroCached/MapServer/WMSServer

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# InfluxDB (optional)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=weather

# Server
API_HOST=0.0.0.0
API_PORT=8000
